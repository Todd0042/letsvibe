# LetsVibe configuration
# ------------------------------------------------------------------------------------------------
# 1. Copy this file to `.env` in the project folder:   cp .env.example .env
# 2. Fill in the values below. `.env` is git-ignored: it holds your secrets and never leaves your machine.
# 3. Restart LetsVibe after changing it.
# Nothing in LetsVibe has a built-in admin, email address or domain: they all come from this file.

# ==========================================
# Site admin (you)
# ==========================================
# Your GitHub numeric account ID. It never changes, so it is the safest way to identify the admin.
# Find it at https://api.github.com/users/<your-username> (the "id" field).
ADMIN_GITHUB_ID=
# Your GitHub username. Used only if ADMIN_GITHUB_ID is empty (usernames can be renamed and re-claimed).
ADMIN_GITHUB_USER=
# Where appeal notifications are sent (needs the SMTP settings below). Leave empty to skip emails;
# appeals always appear in the admin console either way.
ADMIN_EMAIL=

# ==========================================
# Sessions
# ==========================================
# A long random secret used to sign sign-in sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Without it (or if shorter than 32 characters), a random secret is used and every restart signs everyone out.
SESSION_SECRET=change_me_to_a_random_64_character_hex_key

# ==========================================
# GitHub sign-in (OAuth app)
# ==========================================
# Create an OAuth app at https://github.com/settings/developers
# "Authorization callback URL" must equal GITHUB_REDIRECT_URI below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback

# ==========================================
# Web server
# ==========================================
HOST=127.0.0.1
PORT=8000

# ==========================================
# Accounts and fair use
# ==========================================
# How many non-admin accounts may sign up in total (0 = private preview: only the admin can sign in).
MAX_REGISTERED_USERS=5
# How many repositories each account may submit per rolling window of WINDOW_HOURS (168 = one week).
SUBMISSIONS_PER_WINDOW=2
WINDOW_HOURS=168

# ==========================================
# Email (optional; only for appeal notifications)
# ==========================================
# Without SMTP_HOST and SMTP_USER, no email is sent (a local copy is logged for development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ==========================================
# Advanced (optional)
# ==========================================
# Database location (default: data/letsvibe.db).
# LETSVIBE_DB_PATH=
# Model context windows in tokens (defaults: 12288 for the 7B, 6144 for the 14B on an 8 GB GPU).
# LETSVIBE_MAX_CTX=
# LETSVIBE_MAX_CTX_14B=
